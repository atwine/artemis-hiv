# Model server settings. Copy this file to .env (git ignores .env) and fill it in.
# Any OpenAI-compatible chat server works. Leave LLM_BASE_URL empty to fall back
# to a local Ollama server (the original setup; see OLLAMA_HOST and OLLAMA_MODEL).

# vLLM (current setup): the server's address up to and including /v1.
LLM_BASE_URL=http://<vllm-host>:8000/v1
# Model id. Empty means "the first model the server lists".
LLM_MODEL=
# Only needed if the server checks a key (vLLM started with --api-key, or OpenRouter).
LLM_API_KEY=

# OpenRouter (hosted models, pay per use):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# LLM_API_KEY=<your OpenRouter key>

# Ollama through its OpenAI-compatible endpoint (for local or fine-tuned models):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=<ollama model tag>

# Phase 2 model comparison (scripts only; the app itself uses the LLM_* settings above).
# An OpenRouter key; set a spending limit on it in the OpenRouter dashboard.
OPENROUTER_API_KEY=

# Hugging Face read token, for downloading the AfriMed-QA questions (Phase 2 scripts only).
HF_TOKEN=

# Backend (Phase 4, backend/README.md). The local Postgres for visit records runs in Docker
# (backend/docker-compose.yml) and is reachable from this laptop only. Pick any long password.
ARTEMIS_DB_PASSWORD=
ARTEMIS_DATABASE_URL=postgresql+psycopg://artemis:<the same password>@127.0.0.1:5434/artemis
# Where the backend listens, and the frontend's address (the only web page allowed to call it).
# ARTEMIS_API_HOST=127.0.0.1
# ARTEMIS_API_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: the folder that holds the search models' weights (a Hugging Face "hub" folder).
# Empty means the library default (C:\Users\<you>\.cache\huggingface\hub on Windows).
# ARTEMIS_MODEL_DIR=D:\Model Weights\huggingface\hub
