         "type": "array"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "List Patients"
   },
   "post": {
    "description": "Add a new made-up case to the database, booked at `appointment_time` on its visit date,\nin one save (owner, 2026-11-27). Add only: an ID already in use is refused (2026-11-26).",
    "operationId": "add_case_api_patients_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/NewCase"
       }
      }
     },
     "required": true
    },
    "responses": {
     "201": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PatientDetail"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Add Case"
   }
  },
  "/api/patients/{patient_id}": {
   "get": {
    "operationId": "get_patient_api_patients__patient_id__get",
    "parameters": [
     {
      "in": "path",
      "name": "patient_id",
      "required": true,
      "schema": {
       "title": "Patient Id",
       "type": "string"
