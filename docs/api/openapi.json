 "info": {
  "title": "ARTEMIS-HIV backend",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/clinic-day": {
   "get": {
    "description": "A clinic day's board: each appointment, in time order, with the state of the patient's\nlatest saved check, whenever it ran (owner, 2026-11-26). Without `date`: today's clinic\nday, else the most recent earlier one (owner, 2026-11-27).",
    "operationId": "clinic_day_api_clinic_day_get",
    "parameters": [
     {
      "in": "query",
      "name": "date",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "format": "date",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Date"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ClinicDay"
        }
       }
      },
      "description": "Successful Response"
     },
     "404": {
      "description": "There is no clinic day on that date."
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Clinic Day"
   }
  },
  "/api/form-choices": {
   "get": {
    "description": "The add-case form's pick lists, so the website offers only what add-case accepts.",
    "operationId": "form_choices_api_form_choices_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/FormChoices"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Form Choices"
   }
  },
  "/api/health": {
   "get": {
    "operationId": "health_api_health_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": {
          "type": "string"
         },
         "title": "Response Health Api Health Get",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Health"
   }
  },
  "/api/patients": {
   "get": {
    "operationId": "list_patients_api_patients_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
