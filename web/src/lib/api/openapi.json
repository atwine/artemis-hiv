          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "extension": {
            "$ref": "#/components/schemas/CardExtension"
          },
          "indicator": {
            "enum": [
              "info",
              "warning",
              "critical"
            ],
            "title": "Indicator",
            "type": "string"
