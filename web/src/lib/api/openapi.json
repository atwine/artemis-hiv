                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Patients"
      },
      "post": {
        "description": "Add a new made-up case where the Streamlit app keeps its added cases. Add only: an ID\nalready in use is refused (owner, 2026-11-26).",
        "operationId": "add_case_api_patients_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewCase"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Add Case"
      }
    },
