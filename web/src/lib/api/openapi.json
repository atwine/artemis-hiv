          "level": {
            "enum": [
              "success",
              "info",
              "warning",
              "error"
            ],
            "title": "Level",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "level",
          "text"
        ],
        "title": "Banner",
        "type": "object"
      },
      "Card": {
